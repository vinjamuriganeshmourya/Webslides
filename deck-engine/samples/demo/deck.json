    {
      "id": "T01",
      "layout": "points",
      "kicker": "NAT Gateway",
      "title": "Outbound-Only Access",
      "lead": "A private subnet still needs to download updates, but it must never accept an unsolicited inbound connection",
      "points": [
        {
          "text": "A NAT gateway, placed in a public subnet",
          "icon": "Waypoints"
        },
        {
          "text": "Lets private instances start outbound connections",
          "icon": "ArrowUpRight"
        },
        {
          "text": "While blocking anything started from outside",
          "icon": "ShieldBan"
        }
      ],
      "figure": {
        "type": "diagram",
        "w": 600,
        "h": 360,
        "boxes": [
          {
