    {
      "id": "T01-B",
      "layout": "points",
      "kicker": "VPC Peering",
      "title": "Private Links Between VPCs",
      "lead": "Peering joins two VPCs one to one, and traffic never crosses the public internet",
      "points": [
        {
          "text": "A peering connection links VPC A and VPC B directly",
          "icon": "Waypoints"
        },
        {
          "text": "VPC B can peer with VPC C as a separate link",
          "icon": "Link2"
        },
        {
          "text": "Peering is not transitive: VPC A cannot reach VPC C through VPC B",
          "icon": "Ban"
        }
      ],
      "figure": {
        "type": "diagram",
        "w": 600,
        "h": 360,
