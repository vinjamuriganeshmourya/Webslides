{
  "name": "deck-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The shared deck engine: a session folder of data (deck.json) in, one self-contained HTML out. See CLAUDE.md.",
  "scripts": {
    "dev": "vite",
    "gen": "node workflow/export/build-deck-css.mjs",
    "build": "npm run gen && tsc -b && vite build",
    "build:html": "npm run gen && tsc -b && vite build -c vite.singlefile.config.ts && node scripts/inline-assets.mjs && node scripts/inline-fonts.mjs",
    "build:review": "npm run gen && vite build -c vite.review.config.ts",
    "preview": "vite preview",
    "typecheck": "npm run gen && tsc -b --noEmit"
  },
  "dependencies": {
    "@babylonjs/core": "^9.34.0",
    "@gsap/react": "^2.1.2",
    "@lottiefiles/dotlottie-react": "^0.21.1",
    "@pixiv/three-vrm": "^3.5.5",
    "@react-spring/web": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "^2.2.0",
    "@rive-app/react-canvas": "^4.38.1",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.187.0",
    "@use-gesture/react": "^10.3.1",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.2",
    "framer-motion": "^11.15.0",
    "gsap": "^3.15.1",
    "lottie-react": "^3.1.2",
    "lucide-react": "1.24.0",
    "mermaid": "^12.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.10.1",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zdog": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dom-to-svg": "0.12.2",
    "playwright": "1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "2.3.3"
  }
}
