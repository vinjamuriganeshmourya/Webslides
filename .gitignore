# Web Slides — repository-level ignores.
#
# One file for the whole repo, deliberately: the deck projects
# (deployement_session_1_v1, deployement_session_1_v2, template, …) are all the
# same shape, so the same rules apply to each. Patterns use `**/` so they match
# at any depth and a new session project inherits them for free.
#
# The principle throughout: the thing that GENERATES an artefact is tracked, the
# artefact is not. Everything ignored here rebuilds from what is committed.

# ── dependencies ──────────────────────────────────────────────────────────
**/node_modules/
# Without a trailing slash as well, a node_modules SYMLINK is not ignored: a
# pattern ending in `/` matches directories only. `slide-kit/flow-lab/node_modules`
# is a symlink to the template's copy, and git offered to commit the symlink
# itself. Unanchored and `**`-prefixed, per the .gitignore rule in CLAUDE.md, so
# it keeps working at any depth.
**/node_modules
.pnp
.pnp.js

# ── build output ──────────────────────────────────────────────────────────
**/dist/
**/dist-ssr/
# The self-contained single-file decks ARE tracked, by request: they are what
# gets handed to an instructor, and a 4 MB HTML that only exists on one laptop
# is not a deliverable. Everything else vite writes here (the unnamed
# index.html duplicate, stray chunks) stays ignored, so the pattern excludes
# the CONTENTS of dist-single rather than the directory itself — a `!` negation
# cannot re-include a file inside an excluded directory.
**/dist-single/*
!**/dist-single/deployment-session-*.html
!**/dist-single/base-template.html
!**/dist-single/python-session-*.html
**/.vite/
*.tsbuildinfo

# ── archives ──────────────────────────────────────────────────────────────
# ~340 MB of zipped snapshots and templates. Git stores them whole on every
# change and they are all reconstructible from the projects themselves.
*.zip
*.tar
*.tar.gz
*.7z
*.rar
versions/

# ── source decks and heavy binaries ───────────────────────────────────────
# sample_ppts is ~240 MB of reference PowerPoint. Reference material, not
# source: keep it on disk, out of the history.
sample_ppts/
*.pptx
*.ppt
# Python_PPT_slide is the same thing for the Python course: one 5.8 MB deck plus a
# reference photo. `*.pptx` above already covers the deck, so without this line the
# folder shows up in every `git status` for the sake of the photo alone.
Python_PPT_slide/
*.mp4
*.mov
*.webm

# ── generated deck exports ────────────────────────────────────────────────
# The builders live beside their output; the builders are tracked.
#   node <project>/workflow/export/build-project-html.mjs   -> deck.html
#   node <project>/workflow/export/build-theme-module.mjs   -> nxtwaveDeck.js
#   node <project>/workflow/export/build-content-data.mjs   -> deckData.js
#   node <project>/workflow/export/build-player.mjs         -> deck-player.html
#   python3 <project>/workflow/export/upload-assets.py      -> assets.json
**/workflow/export/*
!**/workflow/export/*.mjs
!**/workflow/export/*.py
!**/workflow/export/README.md

# fonts.css is ~1.2 MB of embedded woff2, fetched from Google Fonts at build
# time and folded into the self-contained builds. Without it those builds fall
# back to system fonts, so regenerate rather than hand-edit.
**/workflow/export/fonts.css

# Slide renders, SVG exports, preview pages and sign-off sheets — all produced
# by scripts, all measured in megabytes.
**/workflow/slide-types/*.png
**/workflow/slide-types/svg/
**/workflow/slide-types/*.html
**/workflow/preview/
**/workflow/signoff/*.html

# The review app's own build of the deck (`node review.mjs`), component markers and
# all. Regenerated on demand and never handed to anyone, so it is an artefact like
# the previews above. The REVIEW ITSELF is tracked: it lives at
# <course>/workflow/reviews/<session>.review.md, which this does not match.
**/workflow/review/

# review.sh writes this while the app is running, so --stop can find the process
# again. Runtime state, and the pid inside it means nothing on another machine.
review-app/.review.pid

# The generated halves of the slide-host module. `slideModule.tsx` is authored
# and tracked; these two are written by build-theme-module.mjs.
**/src/export/deckCss.ts
**/src/export/revealSteps.ts

# ── secrets — NEVER commit ────────────────────────────────────────────────
.env
.env.local
.env.*.local
**/.env
*.pem
*.key
*credentials*.json
*service-account*.json

# ── logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── editor / OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# ── python ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── QA scratch ────────────────────────────────────────────────────────────
# qa.mjs and video-safe.mjs write screenshots beside the project when pointed at
# a local path; throwaway, never review material.
.playwright-mcp/
qa-*.png
shot*.mjs
*.screenshot.png

# qa.mjs's default output directory. It used to default to an absolute
# /tmp/claude-1000/<session-id>/scratchpad path baked into the script; that moved
# into the project so the harness is session-agnostic, which means the shots now
# land here. Same status as workflow/preview: regenerated on every run, ~5 MB a
# sweep, never reviewed as source.
**/workflow/qa-shots/

# ── deck studio ───────────────────────────────────────────────────────────
# Per-session UI state: revision notes in flight and the pinned Claude Code
# session id. Local to whoever is running the studio; the plan and the review
# file beside it are the record.
**/session_plans/*/studio.json
